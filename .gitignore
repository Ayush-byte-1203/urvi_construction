# ==============================================================================
# Comprehensive .gitignore for Vite React + Django Project
# ==============================================================================

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example
*.env
backend/.env
secrets.json
*.pem
*.key

# --- Dependencies & Package Managers ---
node_modules/
.pnp
.pnp.js
.npm
.yarn/
yarn-debug.log*
yarn-error.log*
npm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# --- Production & Build Outputs ---
dist/
dist-ssr/
build/
out/
.vite/
.vercel/

# --- Test & Lint Caches ---
coverage/
*.lcov
.nyc_output/
.eslintcache

# --- Python & Django Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Django Databases & User Uploads ---
db.sqlite3
db.sqlite3-journal
*.sqlite3
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/
backend/static/
media/
static/

# --- Logs & Runtime Data ---
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# --- IDEs, Editors & OS Junk ---
.DS_Store
**/.DS_Store
*.DS_Store*
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.tmp
*.temp
*.tsbuildinfo
.cache/
.pytest_cache/
.mypy_cache/
.antigravityignore
.gemini/

# --- Microsoft Office Lock Files & Temp Documents ---
~$*
~*.doc*
~*.xls*
~*.ppt*

# --- Archives & Backup Bundles ---
*.zip
*.tar.gz
*.tar
*.rar
*.7z
